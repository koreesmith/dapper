# Copy to .env (which git ignores) to change how Dapper is published on this server.

# The port to publish Dapper on. Default 8080.
#DAPPER_PORT=8585

# Which address to listen on. Use 127.0.0.1 when a reverse proxy on this server handles HTTPS.
# Default is all interfaces.
#DAPPER_BIND=127.0.0.1

# The version to show in the page footer when you build the image yourself (docker compose up --build).
# Use the release you checked out, for example 2.0.0. Left unset it shows "dev".
#DAPPER_VERSION=2.0.0

# --- Only with docker-compose.server.yml (Dapper runs the directory server for you) ---
# The name other machines will use to reach the server, e.g. ldap.example.com. It goes into the server's
# certificate so clients can check it. Default localhost.
#LDAP_HOSTNAME=ldap.example.com
# Extra certificate names or addresses, comma separated.
#LDAP_TLS_NAMES=ldap,10.0.0.5
# Ports the server is published on (defaults 389 and 636) and the address to listen on (default all).
#LDAP_PORT=389
#LDAPS_PORT=636
#LDAP_BIND=0.0.0.0
# Backups: how often the server backs itself up (hours; 0 = never on a schedule) and how many to keep.
#LDAP_BACKUP_INTERVAL_HOURS=24
#LDAP_BACKUP_KEEP=14
